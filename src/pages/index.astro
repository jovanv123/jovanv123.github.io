---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import EducationTimeline from '../components/EducationTimeline.astro';
import FieldRobot from '../components/FieldRobot.astro';
import VideoLoop from '../components/VideoLoop.astro';
import { coverUrl, getProjects, videoPoster } from '../lib/projects';
import { formatDate, getSite, resolveHref, socialLinks } from '../lib/site';

const site = await getSite();
const { profile, experience, education, skills, contact } = site;
const socials = socialLinks(site);

const projects = await getProjects();
// Card thumbnail: the cover, else the first carousel video's poster, else the hover loop's.
const thumbs = await Promise.all(
	projects.map(async ({ data }) => {
		const cover = await coverUrl(data);
		const video = data.slides.find((slide) => slide.type === 'video');
		return cover ?? (video ? videoPoster(video) : data.media && videoPoster({ src: data.media }));
	}),
);

// Hero photo from src/assets/<profile.photo>; a framed placeholder renders until the file exists.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = profile.photo ? photos[`../assets/${profile.photo}`]?.default : undefined;

// Contact: closing line, email, then GitHub · LinkedIn · CV; anything empty is left out.
const email = contact.show_email ? profile.email : '';
const contactLinks = [
	...socials.filter((social) => ['GitHub', 'LinkedIn'].includes(social.label)),
	profile.cv ? { label: 'CV', href: resolveHref(profile.cv) } : null,
].filter((link) => link !== null);

const row = 'grid gap-x-8 gap-y-3 py-8 md:grid-cols-12';
---

<BaseLayout bleed>
	<section id="about" aria-labelledby="hero-heading" class="relative isolate scroll-mt-24 overflow-hidden">
		<FieldRobot />
		<div class="relative mx-auto grid w-full max-w-content items-center gap-8 px-4 pt-12 pb-10 md:grid-cols-12 md:px-8 md:pt-24 md:pb-20">
			<div class="md:order-1 md:col-span-7" data-nogo>
				<h1 id="hero-heading" class="text-hero tracking-tighter">
					{profile.greeting} <span class="text-accent">{profile.name}.</span>
				</h1>
				<p class="mt-4 max-w-xl text-xl leading-snug tracking-tight text-muted">{profile.tagline}</p>
				<p class="meta mt-6 flex items-center gap-3">
					<span class="inline-block size-2 shrink-0 bg-accent" aria-hidden="true"></span>
					{profile.status}
				</p>
				<p class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
					<a href="#projects">View work →</a>
					{profile.cv && <a href={resolveHref(profile.cv)}>CV ↓</a>}
				</p>
			</div>
			<figure class="-order-1 w-full max-w-photo md:order-2 md:col-span-5 md:justify-self-end" data-nogo>
				<p class="meta mb-2">Fig. 0</p>
				<div class="aspect-square border border-border bg-background">
					{photo ? (
						<Image src={photo} alt={profile.name} widths={[280, 560]} sizes="280px" class="size-full object-cover" loading="eager" />
					) : (
						<div class="meta flex size-full items-center justify-center">Photo</div>
					)}
				</div>
				<figcaption class="meta mt-2 text-right">{profile.location}</figcaption>
			</figure>
		</div>
	</section>

	<section id="projects" aria-labelledby="projects-heading" class="scroll-mt-24 border-y border-border bg-surface">
		<div class="mx-auto max-w-content px-4 py-8 md:px-8 md:py-14">
			<h2 id="projects-heading" class="meta border-b border-border pb-4 text-text">
				<span class="text-muted">01 —</span> {site.projects.heading}
			</h2>
			<ul class="mt-10 grid gap-6 md:grid-cols-3" aria-label={site.featured.heading}>
				{projects.map(({ data }, i) => (
					<li class="min-w-0">
						<a href={`/projects/${data.slug}`} class="group flex h-full flex-col border border-border bg-background text-text no-underline hover:border-accent-hover hover:text-text focus-visible:border-accent">
							{data.media ? (
								<VideoLoop src={data.media} poster={thumbs[i]} autoplay={false} preload="none" class="aspect-4/5 w-full border-b border-border bg-surface object-cover" style={data.focus && { objectPosition: data.focus }} data-thumb aria-hidden="true" />
							) : data.cover && (
								<Image src={data.cover.src} alt="" widths={[360, 720]} sizes="(min-width: 768px) 33vw, 100vw" class="aspect-4/5 w-full border-b border-border object-cover" style={data.focus && { objectPosition: data.focus }} />
							)}
							<div class="flex flex-1 flex-col gap-2 p-5">
								<h3 class="text-xl tracking-tight group-hover:text-accent-hover group-focus-visible:text-accent">{data.title}</h3>
								<p class="font-mono text-xs text-muted">{data.context}</p>
								<p class="mt-auto pt-4 font-mono text-xs text-accent-hover opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">View case study →</p>
								<p class="border-t border-border pt-3 font-mono text-xs">
									{data.result && <>{data.result} <span class="text-muted">·</span> </>}{data.year}
								</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<div class="mx-auto max-w-content px-4 md:px-8">
	<Section id="experience" index="02" heading={experience.heading} ruled={false}>
		<ol class="divide-y divide-border">
			{experience.items.map((item) => (
				<li class={row}>
					<p class="font-mono text-sm text-muted md:col-span-3">
						<time datetime={item.start}>{formatDate(item.start)}</time> –{' '}
						{item.end === 'present' ? item.end : <time datetime={item.end}>{formatDate(item.end)}</time>}
					</p>
					<div class="md:col-span-4">
						<h3 class="text-xl tracking-tight">{item.role}</h3>
						<p class="mt-1 text-sm text-muted">
							{item.company_url ? <a href={item.company_url}>{item.company}</a> : item.company}
						</p>
					</div>
					<ul class="space-y-2 text-muted md:col-span-5">
						{item.points.map((point) => <li>{point}</li>)}
					</ul>
				</li>
			))}
		</ol>
	</Section>

	<Section id="skills" index="03" heading={skills.heading}>
		<ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{skills.groups.map((group) => (
				<li class="group border border-border p-6 hover:border-accent-hover">
					<h3 class="text-lg tracking-tight">{group.name}</h3>
					<ul class="mt-4 space-y-2.5 text-sm text-muted">
						{group.items.map((item) => (
							<li class="flex items-center gap-2.5">
								<Icon name={item.icon} class="size-4 shrink-0 text-text group-hover:text-accent-hover" aria-hidden="true" />
								{item.label}
							</li>
						))}
					</ul>
				</li>
			))}
		</ul>
	</Section>

	<Section id="education" index="04" heading={education.heading}>
		<div class="max-w-narrow">
			<EducationTimeline items={education.items} />
		</div>
	</Section>

	<Section id="contact" index="05" heading={contact.heading}>
		{contact.message && <p class="mt-12 text-4xl tracking-tighter md:text-6xl">{contact.message}</p>}
		{email && (
			<p class="mt-6 text-2xl tracking-tight md:text-4xl">
				<a href={`mailto:${email}`}>{email}</a>
			</p>
		)}
		{contactLinks.length > 0 && (
			<ul class="mt-8 flex flex-wrap gap-x-3 gap-y-2 text-lg" aria-label="Elsewhere">
				{contactLinks.map((link, i) => (
					<li>
						{i > 0 && <span class="mr-3 text-muted" aria-hidden="true">·</span>}
						<a href={link.href}>{link.label}</a>
					</li>
				))}
			</ul>
		)}
	</Section>
	</div>
</BaseLayout>

<script>
	// Project cards (preload="none") load and play on desktop hover and reset on leave.
	// Under prefers-reduced-motion they stay posters.
	const still = window.matchMedia('(prefers-reduced-motion: reduce)');
	const desktop = window.matchMedia('(hover: hover) and (min-width: 64rem)');

	for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-thumb]')) {
		const card = video.closest('a')!;
		card.addEventListener('mouseenter', () => {
			if (desktop.matches && !still.matches) video.play().catch(() => {});
		});
		card.addEventListener('mouseleave', () => {
			video.pause();
			video.currentTime = 0;
		});
	}
</script>
