---
import { render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaCarousel, { type Slide } from '../../components/MediaCarousel.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import SeasonCarousel from '../../components/SeasonCarousel.astro';
import { coverUrl, getProjects, videoPoster } from '../../lib/projects';
import { resolveHref } from '../../lib/site';

export async function getStaticPaths() {
	const projects = await getProjects();
	// "Next project" follows the home list order and wraps around.
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, next: projects[(i + 1) % projects.length] },
	}));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Carousel posters: a video's own (else the cover); an image is its own blurred backdrop.
const cover = await coverUrl(data, 1600);
const sources = data.slides.length > 0 ? data.slides : data.media ? [{ type: 'video' as const, src: data.media, title: data.cover?.alt ?? data.title, text: '' }] : [];
const slides: Slide[] = await Promise.all(
	sources.map(async (slide) =>
		slide.type === 'image'
			? { ...slide, poster: (await getImage({ src: slide.src, width: 640, format: 'jpg' })).src }
			: { ...slide, poster: videoPoster(slide, cover) },
	),
);

// Metadata: Role; hidden when empty.
const facts = [data.role ? { label: 'Role', value: data.role } : null].filter((fact) => fact !== null);

const links = [
	data.repo_url ? { label: 'Code', href: data.repo_url } : null,
	data.paper_url ? { label: 'Paper', href: data.paper_url } : null,
].filter((link) => link !== null);

const sizes = '(min-width: 1100px) 1100px, 100vw';
---

<BaseLayout title={data.title} description={data.summary}>
	<article class="project pt-12">
		{/* Title and context left (~60%), Role right; below a hairline on mobile. */}
		<header class="grid gap-8 md:grid-cols-5 md:gap-12">
			<div class="md:col-span-3">
				<p class="meta"><a href={resolveHref('#projects')} class="no-underline">← Work</a></p>
				<h1 class="mt-3 text-title tracking-tighter">{data.title}</h1>
				<p class="mt-3 font-mono text-sm text-muted">{data.context}</p>
			</div>
			<dl class="grid content-start gap-y-5 border-t border-border pt-5 md:col-span-2 md:border-t-0 md:pt-0">
				{facts.map((fact) => (
					<div>
						<dt class="meta">{fact.label}</dt>
						<dd class="mt-1 text-sm">{fact.value}</dd>
					</div>
				))}
			</dl>
		</header>

		{/* Media: the slide carousel, else the single loop (same stage, no controls), else the cover. */}
		<div class="mt-8 md:mt-12">
			{slides.length > 0 ? (
				<MediaCarousel items={slides} />
			) : data.cover && (
				<Image src={data.cover.src} alt={data.cover.alt} widths={[640, 1100, 2200]} sizes={sizes} class="h-auto w-full" />
			)}
		</div>

		<p class="summary mt-8 md:mt-12">{data.summary}</p>

		{data.publication?.title && (
			<p class="mt-6 flex max-w-text flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
				<span class="meta">Publication</span>
				{data.publication.url ? <a href={data.publication.url} class="text-accent hover:text-accent-hover">{data.publication.title}</a> : <span>{data.publication.title}</span>}
				<span class="font-mono text-xs text-muted">{data.publication.venue} · {data.publication.year}</span>
			</p>
		)}

		<CaseStudy stats={data.stats} comparison={data.comparison}>
			<Content />
			{data.outcome && <SeasonCarousel slot="outcome" items={[data.outcome]} label="Result" />}
		</CaseStudy>

		{data.seasons.length > 0 && (
			<section class="cs-section cs-section-wide" aria-labelledby="seasons-heading">
				<div class="cs-head"><span class="cs-num"></span><h2 id="seasons-heading">Seasons</h2></div>
				<div class="cs-body"><SeasonCarousel items={data.seasons} /></div>
			</section>
		)}

		{data.gallery.length > 0 && (
			<section class="cs-section cs-section-wide" aria-labelledby="gallery-heading">
				<div class="cs-head"><span class="cs-num"></span><h2 id="gallery-heading">Gallery</h2></div>
				<ol class="cs-body divide-y divide-border">
					{data.gallery.map((item) => (
						<li class="py-8 first:pt-0 last:pb-0">
							<figure>
								<Image src={item.src} alt={item.alt} widths={[640, 1100, 2200]} sizes={sizes} class="h-auto w-full" />
								{item.caption && <figcaption class="meta mt-4 max-w-text">{item.caption}</figcaption>}
							</figure>
						</li>
					))}
				</ol>
			</section>
		)}

		{links.length > 0 && (
			<section class="cs-section" aria-labelledby="links-heading">
				<div class="cs-head"><span class="cs-num"></span><h2 id="links-heading">Links</h2></div>
				<ul class="cs-body divide-y divide-border">
					{links.map((link) => (
						<li class="py-3 first:pt-0 last:pb-0"><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</section>
		)}

		<nav aria-label="Next project" class="next-project">
			<a href={resolveHref(`projects/${next.data.slug}/`)} class="group">
				<span class="meta">Next project →</span>
				<span class="next-title">{next.data.title}<span class="next-arrow" aria-hidden="true">→</span></span>
			</a>
		</nav>
	</article>
</BaseLayout>
