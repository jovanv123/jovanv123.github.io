---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import VideoLoop from './VideoLoop.astro';
import { resolveHref } from '../lib/site';

type Caption = { title: string; text: string; poster: string };
export type Slide =
	| (Caption & { type: 'video'; src: string; speed?: string })
	| (Caption & { type: 'image'; src: ImageMetadata; alt: string });

interface Props {
	/** The project's `slides` with posters resolved to URLs (an image is its own poster), or the single `media` loop (empty text). */
	items: Slide[];
}

// One slide at a time on a fixed-height stage (the page never jumps between slides):
// a video or an image, shown whole and centred, with a blurred, darkened copy of its
// poster filling the rest. Only the active video loads and plays. ← / → sit on the
// stage edges; below it one caption line (the text, else the title; the title is also
// the media's aria-label) shares a row with the 01 / 03 counter. A single loop without
// text has no controls or caption. Styles live in global.css (.carousel).
const { items } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const posters = items.map((item) => resolveHref(item.poster));
const single = items.length === 1;
const captioned = items.some((item) => item.text);
const fill = (i: number) => `--poster: url('${posters[i]}')`;
---

<section
	class="carousel"
	data-carousel
	tabindex={single ? undefined : 0}
	aria-roledescription={single ? undefined : 'carousel'}
	aria-label={single ? items[0].title : 'Project media'}
>
	<div class="video-stage" style={fill(0)} data-stage>
		{items.map((item, i) => (
			<figure class="carousel-slide" hidden={i > 0} data-slide data-poster={posters[i]}>
				{item.type === 'video' ? (
					<VideoLoop src={item.src} poster={posters[i]} autoplay={i === 0} preload={i === 0 ? 'metadata' : 'none'} aria-label={item.title} />
				) : (
					<Image src={item.src} alt={item.alt} widths={[640, 1100, 2200]} sizes="(min-width: 1100px) 1100px, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
				)}
				{item.type === 'video' && item.speed && <span class="carousel-speed">{item.speed} speed</span>}
			</figure>
		))}
		{!single && (
			<>
				<button type="button" class="carousel-button carousel-prev" aria-label="Previous slide" data-prev>←</button>
				<button type="button" class="carousel-button carousel-next" aria-label="Next slide" data-next>→</button>
			</>
		)}
	</div>
	{(captioned || !single) && (
		<div class="carousel-meta">
			<div class="carousel-caption" aria-live="polite">
				{items.map((item, i) => (
					<p class:list={['carousel-text max-w-text text-muted', i === 0 && 'is-active']} data-caption>{item.text || item.title}</p>
				))}
			</div>
			{!single && <p class="carousel-counter meta"><span data-index>01</span> / {pad(items.length)}</p>}
		</div>
	)}
</section>

<script>
	import { initCarousel } from '../lib/carousel';

	for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
		const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
		const captions = [...root.querySelectorAll<HTMLElement>('[data-caption]')];
		const stage = root.querySelector<HTMLElement>('[data-stage]')!;
		if (slides.length < 2) continue;

		// Only the active video loads and plays; the others reset to their poster.
		initCarousel(root, slides.length, stage, (current) => {
			slides.forEach((slide, i) => {
				const video = slide.querySelector('video');
				slide.hidden = i !== current;
				if (!video) return;
				if (i === current) {
					video.preload = 'metadata';
					video.play().catch(() => {});
				} else if (!video.paused || video.currentTime > 0) {
					video.pause();
					video.currentTime = 0;
				}
			});
			stage.style.setProperty('--poster', `url('${slides[current].dataset.poster}')`);
			captions.forEach((caption, i) => caption.classList.toggle('is-active', i === current));
		});
	}
</script>
