---
import { socialLinks, type Site } from '../lib/site';

interface Props {
	site: Site;
}

const { site } = Astro.props;
const { footer, profile } = site;
const socials = socialLinks(site);

// Contact and Elsewhere are filled from profile.email and socials; columns with nothing to show are hidden.
const columns = footer.columns
	.map((column) => ({
		...column,
		email: column.heading === 'Contact' ? profile.email : '',
		links: column.heading === 'Elsewhere' ? socials : [],
	}))
	.filter((column) => column.text || column.email || column.links.length > 0);
---

<footer class="border-t border-border">
	<div class="mx-auto max-w-content px-4 md:px-8">
		<div class="grid gap-10 py-14 sm:grid-cols-3">
			{columns.map((column) => (
				<section>
					<h2 class="meta mb-3">{column.heading}</h2>
					{column.text && <p class="text-sm">{column.text}</p>}
					{column.email && (
						<p class="text-sm"><a href={`mailto:${column.email}`}>{column.email}</a></p>
					)}
					{column.links.length > 0 && (
						<ul class="space-y-1 text-sm">
							{column.links.map((social) => (
								<li><a href={social.href}>{social.label}</a></li>
							))}
						</ul>
					)}
				</section>
			))}
		</div>
		<div class="flex justify-between gap-4 border-t border-border py-6">
			<p class="meta">{footer.text}</p>
			{footer.show_back_to_top && <a href="#main" class="meta no-underline">Back to top ↑</a>}
		</div>
	</div>
</footer>
