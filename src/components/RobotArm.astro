---
// Hero background: planar 3-link arm as line art. The end-effector follows the
// cursor (CCD IK, joint limits, damping); idle, off-hero or on touch it traces a
// figure-8. Static pose under prefers-reduced-motion. Decorative only.
// The base sits bottom-right; links never enter elements marked [data-arm-avoid]
// (hero text and photo) or drop below the base line.
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
	<canvas data-arm class="size-full"></canvas>
	<p data-arm-readout class="meta absolute right-8 bottom-4 hidden normal-case md:block"></p>
</div>

<script>
	type Point = { x: number; y: number };
	type Box = { x0: number; x1: number; y0: number; y1: number };

	const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-arm]')!;
	const readout = document.querySelector<HTMLElement>('[data-arm-readout]')!;
	const avoid = [...document.querySelectorAll<HTMLElement>('[data-arm-avoid]')];
	const ctx = canvas.getContext('2d')!;
	const css = getComputedStyle(document.documentElement);
	const color = (name: string) => css.getPropertyValue(`--site-color-${name}`).trim();
	const [line, accent, paper] = [color('line'), color('accent'), color('background')];

	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const deg = Math.PI / 180;
	// Joint limits: q1 absolute from +x (y up), q2/q3 relative to the previous link.
	const limits = [[60 * deg, 180 * deg], [-150 * deg, 150 * deg], [-150 * deg, 150 * deg]];
	const ratios = [0.4, 0.34, 0.26];
	// Start poses, tried in order until one is collision-free: upright, bent, flat along the floor.
	const rests = [[90, 0, 0], [120, -30, -40], [150, -60, -60], [180, 0, 0]].map((p) => p.map((a) => a * deg));
	const gap = 12; // clearance around avoided elements, px

	let w = 0, h = 0, reach = 0, bx = 0, by = 0, lengths = ratios;
	let boxes: Box[] = [];
	let q = [...rests[0]]; // displayed pose
	let s = [...q]; // IK solution, warm-started each frame to avoid branch flips
	let goal = { x: 0, y: 0 }, aim = { x: 0, y: 0 };
	let lastMove = -Infinity, phase = 0.6, visible = false, last = 0, parked = false;
	let loop = (t: number): Point => ({ x: bx, y: by + t });

	// Forward kinematics in y-up coordinates; returns base, joints and end-effector.
	function chain(angles: number[]) {
		const pts = [{ x: bx, y: by }];
		let a = 0;
		angles.forEach((qi, i) => {
			a += qi;
			const p = pts[i];
			pts.push({ x: p.x + lengths[i] * Math.cos(a), y: p.y + lengths[i] * Math.sin(a) });
		});
		return pts;
	}

	const inside = (p: Point, b: Box) => p.x > b.x0 && p.x < b.x1 && p.y > b.y0 && p.y < b.y1;

	// True if any link passes through an avoided box or below the base line.
	function hits(angles: number[]) {
		const pts = chain(angles);
		for (let i = 1; i < pts.length; i++) {
			const a = pts[i - 1], b = pts[i];
			const n = Math.ceil(Math.hypot(b.x - a.x, b.y - a.y) / 4);
			for (let k = 1; k <= n; k++) {
				const p = { x: a.x + ((b.x - a.x) * k) / n, y: a.y + ((b.y - a.y) * k) / n };
				if (p.y < by - 1 || boxes.some((box) => inside(p, box))) return true;
			}
		}
		return false;
	}

	// CCD that only accepts joint steps (full or half) that keep the arm collision-free.
	function solve(t: Point, iterations: number) {
		for (let n = 0; n < iterations; n++) {
			for (let i = s.length - 1; i >= 0; i--) {
				const pts = chain(s);
				const p = pts[i], e = pts[pts.length - 1];
				let d = Math.atan2(t.y - p.y, t.x - p.x) - Math.atan2(e.y - p.y, e.x - p.x);
				d = Math.atan2(Math.sin(d), Math.cos(d));
				const prev = s[i];
				for (const step of [d, d / 2]) {
					s[i] = Math.min(limits[i][1], Math.max(limits[i][0], prev + step));
					if (!hits(s)) break;
					s[i] = prev;
				}
			}
		}
	}

	// Keep targets inside the workspace annulus, above the floor and outside avoided boxes.
	function clampGoal(p: Point) {
		const dx = p.x - bx, dy = Math.max(p.y, by + 8) - by;
		const r = Math.hypot(dx, dy) || 1;
		const k = Math.min(0.97 * reach, Math.max(0.2 * reach, r)) / r;
		const c = { x: bx + dx * k, y: by + dy * k };
		for (const b of boxes) {
			if (!inside(c, b)) continue;
			const exits = [
				{ d: c.x - b.x0, x: b.x0, y: c.y },
				{ d: b.x1 - c.x, x: b.x1, y: c.y },
				{ d: c.y - b.y0, x: c.x, y: b.y0 },
				{ d: b.y1 - c.y, x: c.x, y: b.y1 },
			];
			const e = exits.reduce((m, o) => (o.d < m.d ? o : m));
			c.x = e.x;
			c.y = e.y;
		}
		return c;
	}

	// Figure-8 (lemniscate of Gerono) in the free space: upright in the right margin
	// beside the photo when it is wide enough, otherwise flat in the strip under the content.
	function fitLoop() {
		const right = Math.max(...boxes.map((b) => b.x1), 0);
		const floor = Math.min(...boxes.filter((b) => b.x1 > bx - reach).map((b) => b.y0), h);
		if (w - right > 0.4 * reach) {
			const cx = (right + w) / 2, cy = by + 0.45 * reach, ax = 0.25 * (w - right);
			loop = (t) => ({ x: cx + ax * Math.sin(2 * t), y: cy + 0.3 * reach * Math.sin(t) });
		} else {
			const cy = (by + floor) / 2, ay = 0.25 * (floor - by);
			loop = (t) => ({ x: bx - 0.55 * reach + 0.3 * reach * Math.sin(t), y: cy + ay * Math.sin(2 * t) });
		}
	}

	function draw() {
		ctx.clearRect(0, 0, w, h);
		if (parked) return;
		const pts = chain(q).map((p) => ({ x: p.x, y: h - p.y }));
		ctx.strokeStyle = line;
		ctx.lineWidth = 1;

		ctx.setLineDash([1, 6]);
		ctx.beginPath();
		ctx.arc(bx, h - by, reach, 0, 2 * Math.PI);
		ctx.stroke();
		ctx.setLineDash([]);

		ctx.beginPath();
		ctx.moveTo(bx - 16, h - by);
		ctx.lineTo(bx + 16, h - by);
		pts.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
		ctx.stroke();

		pts.forEach((p, i) => {
			const end = i === pts.length - 1;
			ctx.beginPath();
			ctx.arc(p.x, p.y, end ? 3.5 : 3, 0, 2 * Math.PI);
			ctx.fillStyle = end ? accent : paper;
			ctx.fill();
			if (!end) ctx.stroke();
		});

		readout.textContent = q.map((qi, i) => `q${i + 1} ${(qi / deg).toFixed(1)}°`).join('  ');
	}

	function resize() {
		const dpr = devicePixelRatio || 1;
		w = canvas.clientWidth;
		h = canvas.clientHeight;
		canvas.width = Math.round(w * dpr);
		canvas.height = Math.round(h * dpr);
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		const desktop = w >= 768;
		const pad = desktop ? 40 : 16;
		// Workspace scales with the hero's content height.
		reach = Math.min(h * 0.75, w * (desktop ? 0.4 : 0.45));
		lengths = ratios.map((r) => r * reach);
		bx = w - pad;
		by = pad;

		const c = canvas.getBoundingClientRect();
		boxes = avoid.map((el) => {
			const r = el.getBoundingClientRect();
			return { x0: r.left - c.left - gap, x1: r.right - c.left + gap, y0: c.bottom - r.bottom - gap, y1: c.bottom - r.top + gap };
		});
		fitLoop();

		// Keep the current pose if it still fits the new layout, otherwise park on a free rest pose.
		const rest = hits(q) ? rests.find((r) => !hits(r)) : q;
		parked = !rest;
		if (rest) q = [...rest];
		s = [...q];
		aim = goal = loop(phase);
		if (still) {
			solve(clampGoal(goal), 40);
			q = [...s];
		}
		draw();
	}

	function frame(now: number) {
		if (!visible) return;
		const dt = Math.min((now - last) / 1000 || 0, 0.05);
		last = now;
		if (now - lastMove > 2500) {
			phase += (dt * 2 * Math.PI) / 16;
			goal = loop(phase);
		}
		const ka = 1 - Math.exp(-dt * 5), kq = 1 - Math.exp(-dt * 9);
		aim = { x: aim.x + (goal.x - aim.x) * ka, y: aim.y + (goal.y - aim.y) * ka };
		if (!parked) {
			solve(clampGoal(aim), 4);
			const next = q.map((qi, i) => qi + (s[i] - qi) * kq);
			if (hits(next)) s = [...q];
			else q = next;
		}
		draw();
		requestAnimationFrame(frame);
	}

	const sizes = new ResizeObserver(resize);
	[canvas, ...avoid].forEach((el) => sizes.observe(el));

	if (!still) {
		addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'mouse') return;
			const r = canvas.getBoundingClientRect();
			const x = e.clientX - r.left, y = e.clientY - r.top;
			if (x < 0 || y < 0 || x > r.width || y > r.height) {
				lastMove = -Infinity;
				return;
			}
			goal = { x, y: h - y };
			lastMove = performance.now();
		});
		document.documentElement.addEventListener('mouseleave', () => (lastMove = -Infinity));

		new IntersectionObserver(([entry]) => {
			const was = visible;
			visible = entry.isIntersecting;
			if (visible && !was) {
				last = performance.now();
				requestAnimationFrame(frame);
			}
		}).observe(canvas);
	}
</script>
