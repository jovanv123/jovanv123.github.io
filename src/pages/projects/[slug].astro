---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoLoop from '../../components/VideoLoop.astro';
import VideoCarousel from '../../components/VideoCarousel.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
	const projects = await getProjects();
	// "Next project" follows the home list order and wraps around.
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, next: projects[(i + 1) % projects.length] },
	}));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Metadata row: Year · Role · Result · Stack, hidden when empty.
const facts = [
	{ label: 'Year', value: String(data.year) },
	data.role ? { label: 'Role', value: data.role } : null,
	data.result ? { label: 'Result', value: data.result } : null,
	{ label: 'Stack', value: data.tags.join(' / '), mono: true },
].filter((fact) => fact !== null);

const links = [
	data.repo_url ? { label: 'Code', href: data.repo_url } : null,
	data.paper_url ? { label: 'Paper', href: data.paper_url } : null,
].filter((link) => link !== null);

const sizes = '(min-width: 800px) 800px, 100vw';
---

<BaseLayout title={data.title} description={data.summary}>
	<article class="project pt-16 md:pt-24">
		<header>
			<p class="meta"><a href="/#projects" class="no-underline">← Projects</a></p>
			<h1 class="mt-10 text-4xl leading-none tracking-tighter sm:text-5xl md:text-6xl">{data.title}</h1>
			<p class="mt-6 font-mono text-sm text-muted">{data.context}</p>
			<dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-border pt-6 md:grid-cols-4">
				{facts.map((fact) => (
					<div>
						<dt class="meta">{fact.label}</dt>
						<dd class:list={['mt-2 text-sm', fact.mono && 'font-mono']}>{fact.value}</dd>
					</div>
				))}
			</dl>
		</header>

		{/* Video carousel, else the hero loop, else the cover. */}
		<div class="mt-12">
			{data.videos.length > 0 ? (
				<VideoCarousel items={data.videos} />
			) : data.media ? (
				<VideoLoop src={data.media} class="aspect-video w-full object-cover" aria-label={data.cover?.alt ?? data.title} />
			) : data.cover && (
				<Image src={data.cover.src} alt={data.cover.alt} widths={[640, 800, 1600]} sizes={sizes} class="aspect-video w-full object-cover" />
			)}
		</div>

		<p class="mt-12 max-w-text text-xl leading-relaxed md:text-2xl">{data.summary}</p>

		<div class="case-study">
			<Content />
		</div>

		{data.gallery.length > 0 && (
			<section aria-labelledby="gallery-heading">
				<h2 id="gallery-heading" class="section-heading">Gallery</h2>
				<ol class="mt-10 divide-y divide-border">
					{data.gallery.map((item) => (
						<li class="py-10 first:pt-0">
							<figure>
								<Image src={item.src} alt={item.alt} widths={[640, 800, 1600]} sizes={sizes} class="h-auto w-full" />
								{item.caption && <figcaption class="meta mt-4 max-w-text">{item.caption}</figcaption>}
							</figure>
						</li>
					))}
				</ol>
			</section>
		)}

		{links.length > 0 && (
			<section aria-labelledby="links-heading">
				<h2 id="links-heading" class="section-heading">Links</h2>
				<ul class="mt-10 max-w-text divide-y divide-border border-y border-border">
					{links.map((link) => (
						<li class="py-5"><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</section>
		)}

		<nav aria-label="Next project" class="mt-16 border-t border-border py-16 md:mt-20 md:py-20">
			<a href={`/projects/${next.data.slug}`} class="group no-underline">
				<span class="meta block group-hover:text-accent-hover group-focus-visible:text-accent">Next project →</span>
				<span class="mt-3 block text-2xl tracking-tight md:text-3xl">{next.data.title}</span>
			</a>
		</nav>
	</article>
</BaseLayout>
