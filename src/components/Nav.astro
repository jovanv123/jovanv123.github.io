---
import { resolveHref, type Site } from '../lib/site';

interface Props {
	site: Site;
}

const { nav } = Astro.props.site;
---

<header class:list={['z-10 bg-inverse text-inverse-text', { 'sticky top-0': nav.sticky }]}>
	<a href="#main" class="meta sr-only bg-inverse p-4 focus:not-sr-only focus:absolute">Skip to content</a>
	<nav
		aria-label="Primary"
		class="mx-auto flex max-w-content flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between md:px-8 md:py-5"
	>
		<a href="/" class="font-medium tracking-tight no-underline hover:text-inverse-text">{nav.logo_text}</a>
		<ul class="flex flex-wrap gap-x-6 gap-y-2">
			{nav.links.map((link) => (
				<li>
					<a href={resolveHref(link.href)} class="meta text-inverse-text no-underline decoration-accent-hover hover:text-inverse-text hover:underline">{link.label}</a>
				</li>
			))}
		</ul>
	</nav>
</header>
