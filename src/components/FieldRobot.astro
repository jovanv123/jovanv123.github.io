---
// Hero background: a mini navigation stack on a 3000 × 2000 mm field. The obstacles are
// the [data-nogo] elements (hero text, photo, readout, reset link), boxed tightly per text line
// and image: a 2D lidar sees their edges, a log-odds grid maps the free space around them (they are never mapped, painted or
// driven through), A* plans (unknown space optimistic, line-of-sight smoothed) and pure
// pursuit follows. Known cells decay back to unknown over ~60 s, so exploring never ends.
// Only rays, hits, path, goal and robot are drawn; the map itself stays invisible. Reduced motion: a pre-explored static map with
// one planned path. Hidden and not run under 768px (md), where the hero is just text and photo.
// Readout lines are padded to a fixed width (monospace) so the box never resizes;
// the placeholders give it its final size before the script runs.
const readout = ['x', 'y', 'θ', 'v', 'ω', 'goal —', 'path —', 'explored 0%', 'replan 0.0 ms'].map((line) => line.padEnd(17));
---

<div class="pointer-events-none absolute inset-0 hidden overflow-hidden md:block" aria-hidden="true">
	<canvas data-field class="size-full"></canvas>
	<p data-readout data-nogo class="absolute right-8 bottom-4 grid grid-cols-3 gap-x-6 font-mono text-xs text-muted wide:grid-cols-1">
		{readout.map((line) => <span class="whitespace-pre">{line}</span>)}
	</p>
</div>
<button
	type="button"
	data-reset
	data-nogo
	class="meta absolute top-4 right-8 hidden cursor-pointer normal-case underline decoration-border underline-offset-4 hover:text-accent-hover hover:decoration-current md:motion-safe:inline">reset map</button
>

<script>
	const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-field]')!;
	const hero = canvas.closest('section')!;
	const out = document.querySelector<HTMLElement>('[data-readout]')!;
	const spans = [...out.children] as HTMLElement[];
	const nogo = [...hero.querySelectorAll<HTMLElement>('[data-nogo]')];
	const ctx = canvas.getContext('2d')!;
	const layer = document.createElement('canvas'); // static grid lines and ticks
	const layerCtx = layer.getContext('2d')!;
	const css = getComputedStyle(document.documentElement);
	const color = (name: string) => css.getPropertyValue(`--site-color-${name}`).trim();
	const [grid, ink, accent, paper, muted] = ['border', 'text', 'accent', 'background', 'muted'].map(color);
	const font = `10px ${getComputedStyle(out).fontFamily}`;
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

	const W = 3000, H = 2000, RANGE = 1200, LOOK = 150; // mm
	const V_MAX = 400, A_MAX = 600, W_MAX = 2, DT = 0.01; // mm/s, mm/s², rad/s, 100 Hz
	const MISS = -12, FREE = -20; // log-odds step per pass-through and free threshold, clamped to -100
	const DECAY = 0.75; // s per +1 log-odds: a saturated cell (-100) is unknown again after ~60 s
	const UNKNOWN = 2; // A* cost multiplier for unknown cells
	const HIST = 6, MAXW = 256; // scans kept for the 0.5 s hit fade, max waypoints
	const MIN_LEG = 600; // mm: frontiers closer than this are only used when nothing farther is left
	const SCALE = 1.5, PAD = 40, BUFFER = 10, EDGE = 48; // robot size; px: no-go beyond each text line / image (body + label + gap), planning buffer, hero inset
	const CORNER = Math.PI / 6, V_CORNER = 100; // bends sharper than 30° are driven to, at ≤ 100 mm/s
	// ArUco DICT_4X4_50 id 7 inner bits, 1 = white (checked with cv2.aruco.detectMarkers).
	const BITS = ['0110', '0010', '0111', '0001'];
	const DI = Int8Array.of(1, -1, 0, 0, 1, 1, -1, -1), DJ = Int8Array.of(0, 0, 1, -1, 1, -1, 1, -1);
	const DASH = [4, 4], SOLID: number[] = [];

	// Layout and grid. stat: bit 1 = no-go (never mapped), bit 2 = too close to the hero edge,
	// bit 4 = planning buffer (BUFFER px beyond no-go) so the path keeps clear even when tracking drifts,
	// bit 8 = the shown text or photo itself (with bit 1), where lidar rays stop.
	let w = 0, h = 0, sx = 1, sy = 1, gx = 100, gy = 100, layout = '', parked = true;
	const CS = 25, NX = W / CS, NY = H / CS, RAYS = 72; // 25 mm cells, 72 rays (5°)
	let N = 0;
	let stat = new Uint8Array(0), state = stat, bad = stat; // state: 0 unknown, 1 free
	let L = new Int8Array(0); // log-odds
	let g = new Float32Array(0), fv = g;
	let came = new Int32Array(0), heap = came, hpos = came, queue = came, cells = came;
	let seen = new Uint32Array(0), closed = seen;
	let run = 0, hn = 0, qn = 0, known = 0, mappable = 0, decayed = 0;

	// Robot, path and sensor state.
	let x = 0, y = 0, th = Math.PI, v = 0, om = 0;
	const wx = new Float32Array(MAXW), wy = new Float32Array(MAXW);
	let wn = 0, seg = 0, remain = 0;
	let goal = -1, goalX = 0, goalY = 0, hasGoal = false, exploring = false, noPath = false, needReplan = false;
	let lastPlan = -9, lastExplore = -9, idleT = 0, planMs = 0, prevX = 0, prevY = 0;
	const rayX = new Float32Array(72), rayY = new Float32Array(72);
	const hitX = new Float32Array(HIST * 72), hitY = new Float32Array(HIST * 72);
	const hitN = new Int32Array(HIST), hitT = new Float64Array(HIST);
	let scans = 0, rays = 0, scanX = 0, scanY = 0;
	let simT = 0, acc = 0, last = 0, ticks = 0, shown = -1, inView = false, running = false, scheduled = false;

	const clamp = (a: number, m: number) => (a > m ? m : a < -m ? -m : a);
	const wrap = (a: number) => Math.atan2(Math.sin(a), Math.cos(a));
	const cx = (k: number) => ((k % NX) + 0.5) * CS; // cell centre, mm
	const cy = (k: number) => (((k / NX) | 0) + 0.5) * CS;
	const cellAt = (px: number, py: number) => ((py / CS) | 0) * NX + ((px / CS) | 0);
	// Escape mode (robot inside a margin) may cross margins, never no-go.
	const blocked = (c: number, escape: boolean) => stat[c] & 1 || (!escape && stat[c] !== 0);
	const row = (label: string, value: string, unit: string) => `${label}${value.padStart(9)}${unit}`.padEnd(17);
	// Grid step (mm) whose on-screen cell is closest to 48px.
	const step = (s: number) => [50, 100, 200, 250, 500].reduce((m, c) => (Math.abs(c * s - 48) < Math.abs(m * s - 48) ? c : m));

	function octile(a: number, b: number) {
		const dx = Math.abs((a % NX) - (b % NX)), dy = Math.abs(((a / NX) | 0) - ((b / NX) | 0));
		return dx + dy + (Math.SQRT2 - 2) * Math.min(dx, dy);
	}

	function alloc(n: number) {
		N = n;
		[stat, state, bad] = [0, 0, 0].map(() => new Uint8Array(n));
		L = new Int8Array(n);
		[g, fv] = [new Float32Array(n), new Float32Array(n)];
		[came, heap, hpos, queue, cells] = [0, 0, 0, 0, 0].map(() => new Int32Array(n));
		[seen, closed] = [new Uint32Array(n), new Uint32Array(n)];
		run = 0;
	}

	// Log-odds update of one cell a ray passed through.
	function observe(k: number, d: number) {
		const l = L[k] + d;
		L[k] = l < -100 ? -100 : l;
		if (!state[k] && L[k] < FREE) (state[k] = 1), known++;
	}

	// Forget slowly: every DECAY s all known cells drift +1 towards unknown.
	function decay() {
		for (let k = 0; k < N; k++) {
			if (!L[k]) continue;
			L[k]++;
			if (state[k] && L[k] >= FREE) (state[k] = 0), known--;
		}
	}

	function frontierCell(k: number) {
		if (state[k] !== 1) return false;
		const i = k % NX, j = (k / NX) | 0;
		for (let m = 0; m < 8; m++) {
			const a = i + DI[m], b = j + DJ[m];
			if (a < 0 || a >= NX || b < 0 || b >= NY) continue;
			const c = b * NX + a;
			if (!state[c] && !(stat[c] & 1)) return true;
		}
		return false;
	}

	// 8-connected BFS from s into queue[0..qn). Mode 0: cells clear of no-go and margins.
	// Mode 1: known free cells outside no-go; returns the nearest frontier cell clear of margins
	// at least MIN_LEG away (the nearest one if none is), or -1.
	function bfs(s: number, mode: number) {
		run++;
		qn = 0;
		queue[qn++] = s;
		seen[s] = run;
		let near = -1;
		for (let q = 0; q < qn; q++) {
			const k = queue[q], i = k % NX, j = (k / NX) | 0;
			if (mode && k !== s && !stat[k] && !bad[k] && frontierCell(k)) {
				if (Math.hypot(cx(k) - cx(s), cy(k) - cy(s)) >= MIN_LEG) return k;
				if (near < 0) near = k;
			}
			for (let m = 0; m < 8; m++) {
				const a = i + DI[m], b = j + DJ[m];
				if (a < 0 || a >= NX || b < 0 || b >= NY) continue;
				const c = b * NX + a;
				if (seen[c] === run || (mode ? stat[c] & 1 || state[c] !== 1 : stat[c])) continue;
				seen[c] = run;
				queue[qn++] = c;
			}
		}
		return near;
	}

	function push(c: number, f: number) {
		fv[c] = f;
		heap[hn] = c;
		up(hn++);
	}

	function pop() {
		const top = heap[0], end = heap[--hn];
		if (hn) {
			heap[0] = end;
			down(0);
		}
		return top;
	}

	function up(i: number) {
		const c = heap[i], f = fv[c];
		while (i) {
			const p = (i - 1) >> 1, pc = heap[p];
			if (fv[pc] <= f) break;
			heap[i] = pc;
			hpos[pc] = i;
			i = p;
		}
		heap[i] = c;
		hpos[c] = i;
	}

	function down(i: number) {
		const c = heap[i], f = fv[c];
		for (;;) {
			let l = 2 * i + 1;
			if (l >= hn) break;
			if (l + 1 < hn && fv[heap[l + 1]] < fv[heap[l]]) l++;
			if (fv[heap[l]] >= f) break;
			heap[i] = heap[l];
			hpos[heap[i]] = i;
			i = l;
		}
		heap[i] = c;
		hpos[c] = i;
	}

	// A* (octile heuristic, binary heap with decrease-key). Returns t, or the closest
	// reached free cell when t is unreachable. Inside a margin the robot may escape at a cost.
	function astar(s: number, t: number) {
		run++;
		hn = 0;
		const escape = stat[s] !== 0;
		seen[s] = run;
		g[s] = 0;
		came[s] = -1;
		push(s, octile(s, t));
		let best = s, bestH = Infinity;
		while (hn) {
			const k = pop();
			if (k === t) return k;
			closed[k] = run;
			const hk = octile(k, t);
			if (hk < bestH && state[k] === 1 && !stat[k]) (bestH = hk), (best = k);
			const i = k % NX, j = (k / NX) | 0;
			for (let m = 0; m < 8; m++) {
				const a = i + DI[m], b = j + DJ[m];
				if (a < 0 || a >= NX || b < 0 || b >= NY) continue;
				const c = b * NX + a;
				if (closed[c] === run || blocked(c, escape)) continue;
				if (m > 3 && (blocked(j * NX + a, escape) || blocked(b * NX + i, escape))) continue; // no corner cutting
				const cost = g[k] + (m > 3 ? Math.SQRT2 : 1) * (state[c] ? 1 : UNKNOWN) * (stat[c] ? 12 : 1); // escape the buffer by the shortest way
				if (seen[c] !== run) {
					seen[c] = run;
					g[c] = cost;
					came[c] = k;
					push(c, cost + octile(c, t));
				} else if (cost < g[c]) {
					g[c] = cost;
					came[c] = k;
					fv[c] = cost + octile(c, t);
					up(hpos[c]);
				}
			}
		}
		return best;
	}

	// Line of sight: DDA through the cells of segment (x0,y0)→(x1,y1), in cell units;
	// false at the first no-go or margin cell.
	function trace(x0: number, y0: number, x1: number, y1: number) {
		let i = x0 | 0, j = y0 | 0;
		const ie = x1 | 0, je = y1 | 0, dx = x1 - x0, dy = y1 - y0;
		const si = dx > 0 ? 1 : -1, sj = dy > 0 ? 1 : -1, tdx = Math.abs(1 / dx), tdy = Math.abs(1 / dy);
		let tx = dx ? (dx > 0 ? i + 1 - x0 : x0 - i) * tdx : Infinity;
		let ty = dy ? (dy > 0 ? j + 1 - y0 : y0 - j) * tdy : Infinity;
		for (let n = NX + NY + 2; n > 0; n--) {
			const k = j * NX + i;
			if (stat[k]) return false;
			if (i === ie && j === je) break;
			if (tx < ty) (tx += tdx), (i += si);
			else (ty += tdy), (j += sj);
		}
		return true;
	}

	const sight = (a: number, b: number) =>
		trace((a % NX) + 0.5, ((a / NX) | 0) + 0.5, (b % NX) + 0.5, ((b / NX) | 0) + 0.5);

	function clearPath() {
		wn = seg = 0;
	}

	function addWay(k: number) {
		if (wn < MAXW) (wx[wn] = cx(k)), (wy[wn++] = cy(k));
	}

	function plan() {
		needReplan = false;
		lastPlan = simT;
		const s = cellAt(x, y), t0 = performance.now();
		const end = astar(s, goal);
		planMs = performance.now() - t0;
		if (end !== goal) {
			// Unreachable: snap the goal to the nearest reachable free cell.
			if (exploring) bad[goal] = 1;
			noPath = true;
			goal = end;
			goalX = cx(end);
			goalY = cy(end);
		}
		let pn = 0;
		for (let k = end; k >= 0; k = came[k]) pn++;
		for (let k = end, n = pn; k >= 0; k = came[k]) cells[--n] = k;
		clearPath();
		wx[0] = x;
		wy[0] = y;
		wn = 1;
		// Line-of-sight shortcutting: keep only the cells where visibility breaks.
		for (let a = 0, b = 2; b < pn; b++) if (!sight(cells[a], cells[b])) addWay(cells[(a = b - 1)]);
		if (pn > 1) addWay(end);
		remain = 0;
		for (let n = 1; n < wn; n++) remain += Math.hypot(wx[n] - wx[n - 1], wy[n] - wy[n - 1]);
	}

	function setGoal(k: number, explore: boolean) {
		goal = k;
		goalX = cx(k);
		goalY = cy(k);
		hasGoal = true;
		exploring = explore;
		noPath = false;
		needReplan = true;
		lastPlan = -9;
	}

	function arrive() {
		if (exploring && frontierCell(goal)) bad[goal] = 1;
		prevX = goalX;
		prevY = goalY;
		hasGoal = noPath = false;
		remain = 0;
		idleT = simT;
		clearPath();
	}

	// Idle: head for the nearest frontier worth the trip; once the map is done, patrol: sample
	// cells from the farther half of the reachable area (BFS order ≈ distance) and take the one
	// farthest from both the robot and the previous goal, so legs are long and alternate ends.
	function explore() {
		lastExplore = simT;
		const f = bfs(cellAt(x, y), 1);
		if (f >= 0) return setGoal(f, true);
		if (simT - idleT < 1.2 || qn < 2) return;
		let pick = -1, score = -1;
		for (let n = 0; n < 16; n++) {
			const k = queue[(qn / 2 + Math.random() * (qn / 2)) | 0];
			const d = Math.hypot(cx(k) - x, cy(k) - y) + 0.5 * Math.hypot(cx(k) - prevX, cy(k) - prevY);
			if (!stat[k] && d > score) (score = d), (pick = k);
		}
		if (pick >= 0) setGoal(pick, false);
	}

	// 2D lidar: DDA per ray; free along the ray, passing unmapped through the no-go margin,
	// a hit where it meets the text or photo itself, so the hits sit on what is shown.
	function scan() {
		const slot = scans++ % HIST, ox = x / CS, oy = y / CS, max = RANGE / CS;
		let hits = 0;
		for (let m = 0; m < RAYS; m++) {
			const a = th + (m * 2 * Math.PI) / RAYS, dx = Math.cos(a), dy = Math.sin(a);
			const si = dx > 0 ? 1 : -1, sj = dy > 0 ? 1 : -1, tdx = Math.abs(1 / dx), tdy = Math.abs(1 / dy);
			let i = ox | 0, j = oy | 0, t = 0, hit = false;
			let tx = dx ? (dx > 0 ? i + 1 - ox : ox - i) * tdx : Infinity;
			let ty = dy ? (dy > 0 ? j + 1 - oy : oy - j) * tdy : Infinity;
			while (i >= 0 && i < NX && j >= 0 && j < NY) {
				const k = j * NX + i;
				if (stat[k] & 8) {
					hit = true;
					break;
				}
				if (!(stat[k] & 1)) observe(k, MISS);
				if (tx < ty) (t = tx), (tx += tdx), (i += si);
				else (t = ty), (ty += tdy), (j += sj);
				if (t >= max) {
					t = max;
					break;
				}
			}
			rayX[m] = x + dx * t * CS;
			rayY[m] = y + dy * t * CS;
			if (hit) (hitX[slot * 72 + hits] = rayX[m]), (hitY[slot * 72 + hits++] = rayY[m]);
		}
		hitN[slot] = hits;
		hitT[slot] = simT;
		rays = RAYS;
		scanX = x;
		scanY = y;
	}

	// The robot centre must stay on the field and out of no-go cells.
	const collides = (px: number, py: number) => px < 0 || px >= W || py < 0 || py >= H || stat[cellAt(px, py)] & 1;

	// One 10 ms step: sense at 10 Hz, replan on demand (≤ 10 Hz) or every 1 s, pure pursuit, unicycle kinematics.
	function tick() {
		simT += DT;
		if (ticks++ % 10 === 0) scan();
		if (simT - decayed >= DECAY) (decayed = simT), decay();
		if (!hasGoal && simT - idleT > 0.6 && simT - lastExplore > 0.25) explore();
		if (hasGoal && ((needReplan && simT - lastPlan >= 0.1) || simT - lastPlan >= 1)) plan();
		let vt = 0, wt = 0;
		if (hasGoal && wn < 2) arrive();
		else if (hasGoal) {
			let t = 0, px = 0, py = 0;
			for (;;) {
				const ax = wx[seg], ay = wy[seg], bx = wx[seg + 1] - ax, by = wy[seg + 1] - ay;
				t = ((x - ax) * bx + (y - ay) * by) / (bx * bx + by * by || 1);
				if (t < 1 || seg >= wn - 2) {
					t = t < 0 ? 0 : t > 1 ? 1 : t;
					px = ax + bx * t;
					py = ay + by * t;
					break;
				}
				seg++;
			}
			// Lookahead point LOOK mm further along the path, but never past a sharp bend: the robot
			// drives to the corner instead of cutting it towards the content. Remaining and
			// to-corner lengths feed the speed profile.
			let lx = wx[wn - 1], ly = wy[wn - 1], need = LOOK, found = false, corner = Infinity;
			remain = 0;
			for (let n = seg + 1; n < wn; n++) {
				const l = Math.hypot(wx[n] - px, wy[n] - py);
				if (!found && l >= need) (lx = px + ((wx[n] - px) * need) / l), (ly = py + ((wy[n] - py) * need) / l), (found = true);
				if (!found) need -= l;
				remain += l;
				if (n < wn - 1 && corner === Infinity) {
					const turn = wrap(Math.atan2(wy[n + 1] - wy[n], wx[n + 1] - wx[n]) - Math.atan2(wy[n] - wy[n - 1], wx[n] - wx[n - 1]));
					if (Math.abs(turn) > CORNER) {
						corner = remain;
						if (!found) (lx = wx[n]), (ly = wy[n]), (found = true);
					}
				}
				px = wx[n];
				py = wy[n];
			}
			if (Math.hypot(wx[wn - 1] - x, wy[wn - 1] - y) < 15) arrive();
			else {
				const alpha = wrap(Math.atan2(ly - y, lx - x) - th);
				if (Math.abs(alpha) > Math.PI / 3) wt = clamp(3 * alpha, W_MAX); // rotate in place
				else {
					const k = (2 * Math.sin(alpha)) / (Math.hypot(lx - x, ly - y) || 1);
					vt = Math.min(V_MAX, Math.sqrt(2 * A_MAX * remain), Math.sqrt(2 * A_MAX * corner + V_CORNER * V_CORNER));
					wt = vt * k;
					if (Math.abs(wt) > W_MAX) (wt = clamp(wt, W_MAX)), (vt = W_MAX / Math.abs(k));
				}
			}
		}
		v = vt > v ? Math.min(vt, v + A_MAX * DT) : Math.max(vt, v - A_MAX * DT);
		om = wt;
		const nx = x + v * Math.cos(th) * DT, ny = y + v * Math.sin(th) * DT;
		if (collides(nx, ny)) {
			v = om = 0;
			needReplan = hasGoal;
		} else (x = nx), (y = ny);
		th = wrap(th + om * DT);
	}

	function drawRobot(px: number, py: number) {
		const a = -Math.atan2(sy * Math.sin(th), sx * Math.cos(th)); // heading on screen
		ctx.save();
		ctx.translate(px, py);
		ctx.rotate(a);
		ctx.scale(SCALE, SCALE);
		ctx.fillStyle = ink;
		ctx.fillRect(-10, -21, 20, 3);
		ctx.fillRect(-10, 18, 20, 3);
		ctx.strokeStyle = ink;
		ctx.fillStyle = paper;
		ctx.fillRect(-18, -18, 36, 36);
		ctx.strokeRect(-18, -18, 36, 36);
		ctx.fillStyle = accent;
		ctx.beginPath();
		ctx.moveTo(16, 0);
		ctx.lineTo(11, -4);
		ctx.lineTo(11, 4);
		ctx.fill();
		for (let r = 0; r < 6; r++)
			for (let c = 0; c < 6; c++) {
				ctx.fillStyle = r > 0 && r < 5 && c > 0 && c < 5 && BITS[r - 1][c - 1] === '1' ? paper : ink;
				ctx.fillRect(-12 + c * 3.5, -10.5 + r * 3.5, 3.5, 3.5);
			}
		ctx.restore();

		// Camera detection: axis-aligned box around the rotated marker.
		const s = Math.abs(Math.cos(a)) + Math.abs(Math.sin(a)), half = (10.5 * s + 4) * SCALE;
		const bx = px - 1.5 * SCALE * Math.cos(a), by = py - 1.5 * SCALE * Math.sin(a);
		ctx.strokeStyle = ctx.fillStyle = accent;
		ctx.setLineDash(DASH);
		ctx.strokeRect(bx - half, by - half, 2 * half, 2 * half);
		ctx.setLineDash(SOLID);
		ctx.fillText('aruco id=7', Math.min(bx - half, w - 59), by - half - 4);
	}

	function draw() {
		ctx.clearRect(0, 0, w, h);
		if (parked) return;
		ctx.drawImage(layer, 0, 0, w, h);
		ctx.lineWidth = 1;

		if (rays) {
			const ox = scanX * sx, oy = h - scanY * sy;
			ctx.globalAlpha = 0.06;
			ctx.strokeStyle = ink;
			ctx.beginPath();
			for (let m = 0; m < rays; m++) ctx.moveTo(ox, oy), ctx.lineTo(rayX[m] * sx, h - rayY[m] * sy);
			ctx.stroke();
		}
		ctx.fillStyle = accent;
		for (let s = 0; s < HIST; s++) {
			const age = simT - hitT[s];
			if (!hitN[s] || age > 0.5) continue;
			ctx.globalAlpha = 1 - age / 0.5;
			for (let n = s * 72; n < s * 72 + hitN[s]; n++) ctx.fillRect(hitX[n] * sx - 1, h - hitY[n] * sy - 1, 2, 2);
		}
		ctx.globalAlpha = 1;

		const rx = x * sx, ry = h - y * sy;
		ctx.strokeStyle = accent;
		if (wn > 1) {
			ctx.setLineDash(DASH);
			ctx.beginPath();
			ctx.moveTo(rx, ry);
			for (let n = seg + 1; n < wn; n++) ctx.lineTo(wx[n] * sx, h - wy[n] * sy);
			ctx.stroke();
			ctx.setLineDash(SOLID);
		}
		if (hasGoal) {
			const gx_ = goalX * sx, gy_ = h - goalY * sy;
			ctx.beginPath();
			ctx.moveTo(gx_ - 5, gy_);
			ctx.lineTo(gx_ + 5, gy_);
			ctx.moveTo(gx_, gy_ - 5);
			ctx.lineTo(gx_, gy_ + 5);
			ctx.stroke();
		}
		drawRobot(rx, ry);

		if (still || simT - shown >= 0.1) {
			shown = simT;
			spans[0].textContent = row('x', x.toFixed(1), ' mm');
			spans[1].textContent = row('y', y.toFixed(1), ' mm');
			spans[2].textContent = row('θ', ((th * 180) / Math.PI).toFixed(1), '°');
			spans[3].textContent = row('v', v.toFixed(1), ' mm/s');
			spans[4].textContent = row('ω', om.toFixed(2), ' rad/s');
			spans[5].textContent = (hasGoal ? `goal (${Math.round(goalX)}, ${Math.round(goalY)})` : 'goal —').padEnd(17);
			spans[6].textContent = (noPath ? 'path no path' : hasGoal ? `path ${(remain / 1000).toFixed(2)} m` : 'path —').padEnd(17);
			spans[7].textContent = `explored ${Math.round((100 * known) / (mappable || 1))}%`.padEnd(17);
			spans[8].textContent = `replan ${planMs.toFixed(1)} ms`.padEnd(17);
		}
	}

	function resetMap() {
		L.fill(0);
		state.fill(0);
		bad.fill(0);
		hitN.fill(0);
		clearPath();
		known = rays = remain = 0;
		hasGoal = exploring = noPath = false;
		idleT = decayed = simT;
	}

	// Reduced motion: map everything at once and show one planned path.
	function preExplore() {
		for (let k = 0; k < N; k++) if (!(stat[k] & 1)) observe(k, -127);
		bfs(cellAt(x, y), 0);
		if (qn < 2) return;
		setGoal(queue[qn - 1], false);
		plan();
	}

	function paintLayer(rects: DOMRect[], dpr: number) {
		layer.width = canvas.width;
		layer.height = canvas.height;
		layerCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
		layerCtx.strokeStyle = grid;
		layerCtx.lineWidth = 1;
		layerCtx.beginPath();
		for (let x = gx; x < W; x += gx) layerCtx.moveTo(Math.round(x * sx) + 0.5, 0), layerCtx.lineTo(Math.round(x * sx) + 0.5, h);
		for (let y = gy; y < H; y += gy) layerCtx.moveTo(0, Math.round(h - y * sy) + 0.5), layerCtx.lineTo(w, Math.round(h - y * sy) + 0.5);
		layerCtx.stroke();
		// Axis ticks in mm, every other line, skipped where they would touch content.
		const near = (px: number, py: number) => rects.some((r) => px > r.left - 4 && px < r.right + 4 && py > r.top - 4 && py < r.bottom + 4);
		layerCtx.font = font;
		layerCtx.fillStyle = muted;
		layerCtx.globalAlpha = 0.6;
		for (let x = 2 * gx; x < W; x += 2 * gx) if (!near(x * sx + 12, h - 8)) layerCtx.fillText(`${x}`, x * sx + 3, h - 4);
		for (let y = 2 * gy; y < H; y += 2 * gy) if (!near(12, h - y * sy - 6)) layerCtx.fillText(`${y}`, 4, h - y * sy - 3);
	}

	// Tight boxes around what a no-go element shows: each line of text and each leaf
	// element with a size (photo, status dot), not the element's whole layout box.
	const range = document.createRange();
	function boxes(el: HTMLElement) {
		const out: DOMRect[] = [];
		const walk = document.createTreeWalker(el, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT);
		for (let n: Node | null = walk.currentNode; n; n = walk.nextNode()) {
			if (n instanceof Element && n.childElementCount) continue;
			if (!n.textContent!.trim()) {
				if (n instanceof Element) out.push(n.getBoundingClientRect());
				continue;
			}
			if (n instanceof Element) continue; // its text node follows
			range.selectNodeContents(n);
			out.push(...range.getClientRects());
		}
		return out.filter((r) => r.width && r.height);
	}

	// (Re)build everything when the hero's size or the no-go elements change.
	function init() {
		const c = canvas.getBoundingClientRect();
		const rects = nogo
			.filter((el) => el.offsetWidth)
			.flatMap(boxes)
			.map((r) => new DOMRect(r.left - c.left, r.top - c.top, r.width, r.height));
		const key = [c.width, c.height, ...rects.flatMap((r) => [r.x, r.y, r.width, r.height])].map(Math.round).join();
		if (key === layout) return;
		layout = key;
		// Hidden below md: nothing to build or run until the canvas has a size.
		if (!canvas.clientWidth) {
			parked = true;
			return sync();
		}

		const dpr = devicePixelRatio || 1;
		w = canvas.clientWidth;
		h = canvas.clientHeight;
		canvas.width = Math.round(w * dpr);
		canvas.height = Math.round(h * dpr);
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		ctx.font = font;
		sx = w / W;
		sy = h / H;
		gx = step(sx);
		gy = step(sy);
		if (!N) alloc(NX * NY);


		mappable = 0;
		for (let k = 0; k < N; k++) {
			const X = cx(k) * sx, Y = h - cy(k) * sy;
			let s = X < EDGE || X > w - EDGE || Y < EDGE || Y > h - EDGE ? 2 : 0;
			for (const r of rects) {
				const d = Math.hypot(Math.max(r.left - X, 0, X - r.right), Math.max(r.top - Y, 0, Y - r.bottom)); // px to the element
				if (d < (CS * sx) / 2) s |= 9;
				else if (d < PAD) s |= 1;
				else if (d < PAD + BUFFER) s |= 4;
			}
			stat[k] = s & 1 ? s & 9 : s;
			if (!(s & 1)) mappable++;
		}
		// Start in the largest free region, at its cell nearest the bottom-right corner.
		bad.fill(0);
		let seed = -1, largest = 0, start = -1, best = -Infinity;
		for (let k = 0; k < N; k++) {
			if (stat[k] || bad[k]) continue;
			bfs(k, 0);
			for (let q = 0; q < qn; q++) bad[queue[q]] = 1;
			if (qn > largest) (largest = qn), (seed = k);
		}
		if (seed >= 0) bfs(seed, 0);
		for (let q = 0; q < qn && seed >= 0; q++) {
			const k = queue[q], score = cx(k) * sx - 1.5 * cy(k) * sy;
			if (score > best) (best = score), (start = k);
		}
		parked = start < 0;
		resetMap();
		paintLayer(rects, dpr);
		if (!parked) {
			x = cx(start);
			y = cy(start);
			th = Math.PI;
			v = om = 0;
			if (still) preExplore();
		}
		draw();
		sync();
	}

	function frame(now: number) {
		scheduled = false;
		if (!running) return;
		acc += Math.min((now - last) / 1000, 0.1);
		last = now;
		for (; acc >= DT; acc -= DT) tick();
		draw();
		scheduled = true;
		requestAnimationFrame(frame);
	}

	// Run only while the hero is on screen and the tab is visible.
	function sync() {
		running = inView && !document.hidden && !still && !parked;
		if (running && !scheduled) {
			scheduled = true;
			last = performance.now();
			requestAnimationFrame(frame);
		}
	}

	let timer = 0;
	// First layout builds immediately; later resizes are debounced.
	const sizes = new ResizeObserver(() => {
		clearTimeout(timer);
		if (!N) init();
		else timer = window.setTimeout(init, 100);
	});
	[canvas, ...nogo].forEach((el) => sizes.observe(el));

	hero.querySelector('[data-reset]')!.addEventListener('click', () => {
		if (!N) return;
		resetMap();
		draw();
	});

	if (!still) {
		hero.addEventListener('click', (e) => {
			if (parked || (e.target as Element).closest('a, button, [data-nogo]')) return;
			const r = canvas.getBoundingClientRect();
			const px = (e.clientX - r.left) / sx, py = (r.bottom - e.clientY) / sy;
			if (px >= 0 && px < W && py >= 0 && py < H) setGoal(cellAt(px, py), false);
		});
		new IntersectionObserver(([entry]) => {
			inView = entry.isIntersecting;
			sync();
		}).observe(canvas);
		document.addEventListener('visibilitychange', sync);
	}
</script>
