---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import RobotArm from '../components/RobotArm.astro';
import VideoLoop from '../components/VideoLoop.astro';
import { getProjects } from '../lib/projects';
import { formatDate, getSite, resolveHref, socialLinks } from '../lib/site';

const site = await getSite();
const { profile, focus, experience, education, skills, contact } = site;
const socials = socialLinks(site);

const projects = await getProjects();
const featured = projects.slice(0, site.featured.count);

// Hero photo from src/assets/<profile.photo>; a framed placeholder renders until the file exists.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = profile.photo ? photos[`../assets/${profile.photo}`]?.default : undefined;
// Contact rows: label | value, hidden when empty.
const contactRows = [
	contact.show_email && profile.email
		? { label: 'Email', text: profile.email, href: `mailto:${profile.email}` }
		: null,
	profile.cv ? { label: 'CV', text: 'Download PDF', href: resolveHref(profile.cv) } : null,
	...socials.map((social) => ({ label: social.label, text: social.href.replace(/^https?:\/\//, ''), href: social.href })),
	profile.location ? { label: 'Based in', text: profile.location } : null,
].filter((row) => row !== null);

const row = 'grid gap-x-8 gap-y-3 py-8 md:grid-cols-12';
---

<BaseLayout bleed>
	<section id="about" aria-labelledby="hero-heading" class="relative isolate flex min-h-hero scroll-mt-24 items-center overflow-hidden">
		<RobotArm />
		<div class="relative mx-auto grid w-full max-w-content items-center gap-12 px-4 pt-12 pb-20 md:grid-cols-12 md:gap-8 md:px-8 md:py-24">
			<div class="md:order-1 md:col-span-7">
				<h1 id="hero-heading" class="text-4xl leading-tight tracking-tighter sm:text-5xl lg:text-6xl">
					{profile.greeting} <span class="text-accent">{profile.name}.</span>
				</h1>
				<p class="mt-6 max-w-xl text-xl leading-snug tracking-tight text-muted md:text-2xl">{profile.tagline}</p>
				<p class="meta mt-10 flex items-center gap-3">
					<span class="inline-block size-2 shrink-0 bg-accent" aria-hidden="true"></span>
					{profile.status}
				</p>
				<p class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
					<a href="#work">View work →</a>
					{profile.cv && <a href={resolveHref(profile.cv)}>CV ↓</a>}
				</p>
			</div>
			<figure class="-order-1 w-full max-w-photo md:order-2 md:col-span-5 md:justify-self-end">
				<p class="meta mb-2">Fig. 0</p>
				<div class="aspect-square border border-border bg-background">
					{photo ? (
						<Image src={photo} alt={`Portrait of ${profile.name}`} widths={[360, 720]} sizes="(min-width: 768px) 360px, 100vw" class="size-full object-cover" loading="eager" />
					) : (
						<div class="meta flex size-full items-center justify-center">Photo</div>
					)}
				</div>
				<figcaption class="meta mt-2 text-right">{profile.location}</figcaption>
			</figure>
		</div>
	</section>

	<section id="work" aria-labelledby="work-heading" class="scroll-mt-24 border-y border-border bg-surface">
		<div class="mx-auto max-w-content px-4 py-20 md:px-8 md:py-24">
			<h2 id="work-heading" class="meta border-b border-border pb-4 text-text">
				<span class="text-muted">01 —</span> {site.featured.heading}
			</h2>
			<ul class="mt-10 grid gap-6 md:grid-cols-3">
				{featured.map(({ data }) => (
					<li>
						<a href={`/projects/${data.slug}`} class="group flex h-full flex-col border border-border bg-background text-text no-underline hover:border-accent hover:text-text focus-visible:border-accent">
							{data.media ? (
								<VideoLoop src={data.media} autoplay={false} preload="none" class="aspect-video w-full border-b border-border object-cover" data-thumb aria-hidden="true" />
							) : (
								<div class="meta flex aspect-video w-full items-center justify-center border-b border-border bg-surface" aria-hidden="true">{data.tags[0]}</div>
							)}
							<div class="flex flex-1 flex-col gap-2 p-5">
								<h3 class="text-xl tracking-tight group-hover:text-accent group-focus-visible:text-accent">{data.title}</h3>
								<p class="font-mono text-xs text-muted">{data.context}</p>
								<p class="mt-auto border-t border-border pt-3 font-mono text-sm">{data.result ?? data.year}</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<div class="mx-auto max-w-content px-4 md:px-8">
	<Section id="projects" index="02" heading={site.projects.heading} ruled={false}>
		<ol class="divide-y divide-border">
			{projects.map(({ data }) => (
				<li>
					<a href={`/projects/${data.slug}`} class="group grid gap-x-8 gap-y-3 py-8 text-text no-underline hover:text-text lg:grid-cols-12">
						<p class="font-mono text-sm text-muted lg:col-span-1">{data.year}</p>
						<div class="lg:col-span-3">
							<h3 class="text-xl tracking-tight group-hover:text-accent group-focus-visible:text-accent md:text-2xl">{data.title}</h3>
							<p class="mt-1 text-sm text-muted">{data.context}</p>
						</div>
						<p class="text-sm lg:col-span-2">{data.result}</p>
						<ul class="meta flex flex-wrap content-start gap-x-3 gap-y-1 lg:col-span-2" aria-label="Tags">
							{data.tags.map((tag) => <li>{tag}</li>)}
						</ul>
						<div class:list={[data.media ? 'flex' : 'hidden lg:flex', 'items-center gap-6 lg:col-span-4 lg:justify-end']}>
							{data.media && (
								<VideoLoop
									src={data.media}
									autoplay={false}
									preload="none"
									class="aspect-video w-60 object-cover"
									data-thumb
									aria-hidden="true"
								/>
							)}
							<span
								class="hidden -translate-x-2 text-xl text-accent opacity-0 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 motion-safe:transition lg:inline"
								aria-hidden="true">→</span>
						</div>
					</a>
				</li>
			))}
		</ol>
	</Section>

	<Section id="focus" index="03" heading={focus.heading}>
		<ul class="divide-y divide-border">
			{focus.items.map((item) => (
				<li class={row}>
					<h3 class="text-xl tracking-tight md:col-span-4">{item.title}</h3>
					<p class="text-muted md:col-span-5">{item.text}</p>
					<div class="md:col-span-3">
						<p class="meta mb-2">Topics</p>
						<p class="font-mono text-sm">{item.topics.join(' / ')}</p>
					</div>
				</li>
			))}
		</ul>
	</Section>

	<Section id="experience" index="04" heading={experience.heading}>
		<ol class="divide-y divide-border">
			{experience.items.map((item) => (
				<li class={row}>
					<p class="font-mono text-sm text-muted md:col-span-3">
						<time datetime={item.start}>{formatDate(item.start)}</time> –{' '}
						{item.end === 'present' ? item.end : <time datetime={item.end}>{formatDate(item.end)}</time>}
					</p>
					<div class="md:col-span-4">
						<h3 class="text-xl tracking-tight">{item.role}</h3>
						<p class="mt-1 text-sm text-muted">
							{item.company_url ? <a href={item.company_url}>{item.company}</a> : item.company}
						</p>
					</div>
					<ul class="space-y-2 text-muted md:col-span-5">
						{item.points.map((point) => <li>{point}</li>)}
					</ul>
				</li>
			))}
		</ol>
	</Section>

	<Section id="education" index="05" heading={education.heading}>
		<ol class="divide-y divide-border">
			{education.items.map((item) => (
				<li class={row}>
					<p class="font-mono text-sm text-muted md:col-span-3">
						<time datetime={item.start}>{formatDate(item.start)}</time> –{' '}
						{item.end === 'present' ? item.end : <time datetime={item.end}>{formatDate(item.end)}</time>}
					</p>
					<div class="md:col-span-4">
						<h3 class="text-xl tracking-tight">{item.degree}</h3>
						<p class="mt-1 text-sm text-muted">{item.school}</p>
					</div>
					{item.note && <p class="text-muted md:col-span-5">{item.note}</p>}
				</li>
			))}
		</ol>
	</Section>

	<Section id="skills" index="06" heading={skills.heading}>
		<dl class="divide-y divide-border">
			{skills.groups.map((group) => (
				<div class="grid gap-x-8 gap-y-2 py-5 md:grid-cols-12">
					<dt class="meta md:col-span-3">{group.name}</dt>
					<dd class="font-mono text-sm md:col-span-9">{group.items.join(' / ')}</dd>
				</div>
			))}
		</dl>
	</Section>

	<Section id="contact" index="07" heading={contact.heading}>
		{contact.message && <p class="mt-8 max-w-2xl text-xl leading-relaxed md:text-2xl">{contact.message}</p>}
		<dl class="divide-y divide-border">
			{contactRows.map((item) => (
				<div class="grid gap-x-8 gap-y-2 py-5 md:grid-cols-12">
					<dt class="meta md:col-span-3">{item.label}</dt>
					<dd class="md:col-span-9">{item.href ? <a href={item.href}>{item.text}</a> : item.text}</dd>
				</div>
			))}
		</dl>
	</Section>
	</div>
</BaseLayout>

<script>
	// Row thumbnails and featured cards (preload="none") load and play on desktop hover and reset on leave.
	// Under prefers-reduced-motion they stay posters.
	const still = window.matchMedia('(prefers-reduced-motion: reduce)');
	const desktop = window.matchMedia('(hover: hover) and (min-width: 64rem)');

	for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-thumb]')) {
		const row = video.closest('a')!;
		row.addEventListener('mouseenter', () => {
			if (desktop.matches && !still.matches) video.play().catch(() => {});
		});
		row.addEventListener('mouseleave', () => {
			video.pause();
			video.currentTime = 0;
		});
	}
</script>
