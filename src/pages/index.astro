---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import VideoLoop from '../components/VideoLoop.astro';
import { getProjects } from '../lib/projects';
import { formatDate, getSite, resolveHref, siteImage, socialLinks } from '../lib/site';

const site = await getSite();
const { profile, hero, now, notes: notesBlock, focus, experience, education, skills, contact } = site;
const socials = socialLinks(site);

const projects = await getProjects();
const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const photo = hero.photo && siteImage(hero.photo.src);

// Contact rows: label | value, hidden when empty.
const contactRows = [
	contact.show_email && profile.email
		? { label: 'Email', text: profile.email, href: `mailto:${profile.email}` }
		: null,
	profile.cv ? { label: 'CV', text: 'Download PDF', href: resolveHref(profile.cv) } : null,
	...socials.map((social) => ({ label: social.label, text: social.href.replace(/^https?:\/\//, ''), href: social.href })),
	profile.location ? { label: 'Based in', text: profile.location } : null,
].filter((row) => row !== null);

// List rows fade in once on load (not on scroll); off under reduced motion.
const row = 'grid gap-x-8 gap-y-3 py-8 md:grid-cols-12 motion-safe:animate-fade-in';
---

<BaseLayout>
	<section id="hero" aria-labelledby="hero-heading" class="grid gap-x-8 pt-16 pb-20 md:pt-28 md:pb-28 lg:grid-cols-12">
		<div class:list={[photo && 'lg:col-span-8']}>
			<p class="meta flex items-center gap-3">
				<span class="inline-block size-2 shrink-0 bg-accent" aria-hidden="true"></span>
				{profile.status}
			</p>
			<h1 id="hero-heading" class="mt-10 max-w-4xl text-5xl leading-none tracking-tighter sm:text-6xl md:text-7xl">
				{hero.headline}
			</h1>
			{hero.rule && <hr class="mt-12 w-20 border-text" />}
			<p class="mt-12 max-w-2xl text-xl leading-relaxed md:text-2xl">{hero.lede}</p>
		</div>
		{photo && (
			<Image
				src={photo}
				alt={hero.photo!.alt}
				widths={[320, 640]}
				sizes="(min-width: 1024px) 340px, 0px"
				loading="eager"
				class="hidden h-auto w-full grayscale hover:grayscale-0 motion-safe:transition lg:col-span-4 lg:block lg:self-end"
			/>
		)}
		<div class="mt-12 flex flex-col gap-6 sm:flex-row sm:items-baseline sm:justify-between lg:col-span-12">
			<a href={resolveHref(hero.link.href)} class="text-lg">{hero.link.label}</a>
			<p class="meta">{profile.name} · {profile.role} · {profile.location}</p>
		</div>
	</section>

	{now.items.length > 0 && (
		<section aria-labelledby="now-heading" class="grid gap-x-8 gap-y-4 border-t border-border py-10 md:grid-cols-12 md:py-12">
			<h2 id="now-heading" class="meta md:col-span-3">{now.heading}</h2>
			<ul class="space-y-2 font-mono text-sm md:col-span-9">
				{now.items.map((item, i) => (
					<li class="flex items-start gap-3">
						<span class:list={['mt-1.5 inline-block size-2 shrink-0', i === 0 ? 'bg-accent' : 'invisible']} aria-hidden="true"></span>
						{item}
					</li>
				))}
			</ul>
		</section>
	)}

	<Section id="projects" heading={site.projects.heading}>
		<ol class="divide-y divide-border">
			{projects.map(({ data }) => (
				<li>
					<a href={`/projects/${data.slug}`} class="group grid gap-x-8 gap-y-3 py-8 text-text no-underline hover:text-text motion-safe:animate-fade-in lg:grid-cols-12">
						<p class="font-mono text-sm text-muted lg:col-span-1">{data.year}</p>
						<div class="lg:col-span-3">
							<h3 class="text-xl tracking-tight group-hover:text-accent group-focus-visible:text-accent md:text-2xl">{data.title}</h3>
							<p class="mt-1 text-sm text-muted">{data.context}</p>
						</div>
						<div class="lg:col-span-2">
							{data.metric && <p class="text-3xl leading-none tracking-tighter">{data.metric}</p>}
							{data.result && <p class:list={['text-sm', data.metric && 'mt-2 text-muted']}>{data.result}</p>}
						</div>
						<ul class="meta flex flex-wrap content-start gap-x-3 gap-y-1 lg:col-span-2" aria-label="Tags">
							{data.tags.map((tag) => <li>{tag}</li>)}
						</ul>
						<div class:list={[data.media ? 'flex' : 'hidden lg:flex', 'items-center gap-6 lg:col-span-4 lg:justify-end']}>
							{data.media && (
								<VideoLoop
									src={data.media}
									autoplay={false}
									preload="none"
									class="aspect-video w-60 object-cover"
									data-thumb
									aria-hidden="true"
								/>
							)}
							<span
								class="hidden -translate-x-2 text-xl text-accent opacity-0 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 motion-safe:transition lg:inline"
								aria-hidden="true">→</span>
						</div>
					</a>
				</li>
			))}
		</ol>
	</Section>

	{notes.length > 0 && (
		<Section id="notes" heading={notesBlock.heading}>
			<ol class="divide-y divide-border">
				{notes.map(({ data }) => (
					<li class="grid gap-x-8 gap-y-2 py-5 motion-safe:animate-fade-in md:grid-cols-12 md:items-center">
						<time datetime={data.date.toISOString().slice(0, 10)} class="font-mono text-sm text-muted md:col-span-2">
							{data.date.toISOString().slice(0, 10)}
						</time>
						<div class="md:col-span-8">
							<h3 class="tracking-tight">
								{data.href ? <a href={resolveHref(data.href)}>{data.title}</a> : data.title}
							</h3>
							<p class="text-sm text-muted">{data.summary}</p>
						</div>
						{data.image && (
							<Image
								src={data.image.src}
								alt={data.image.alt}
								widths={[128, 256]}
								sizes="128px"
								class="aspect-video w-32 object-cover md:col-span-2 md:justify-self-end"
							/>
						)}
					</li>
				))}
			</ol>
		</Section>
	)}

	<Section id="focus" heading={focus.heading}>
		<ul class="divide-y divide-border">
			{focus.items.map((item) => (
				<li class={row}>
					<h3 class="text-xl tracking-tight md:col-span-4">{item.title}</h3>
					<p class="text-muted md:col-span-5">{item.text}</p>
					<div class="md:col-span-3">
						<p class="meta mb-2">Topics</p>
						<p class="font-mono text-sm">{item.topics.join(' / ')}</p>
					</div>
				</li>
			))}
		</ul>
	</Section>

	<Section id="experience" heading={experience.heading}>
		<ol class="divide-y divide-border">
			{experience.items.map((item) => (
				<li class={row}>
					<p class="font-mono text-sm text-muted md:col-span-3">
						<time datetime={item.start}>{formatDate(item.start)}</time> –{' '}
						{item.end === 'present' ? item.end : <time datetime={item.end}>{formatDate(item.end)}</time>}
					</p>
					<div class="md:col-span-4">
						<h3 class="text-xl tracking-tight">{item.role}</h3>
						<p class="mt-1 text-sm text-muted">
							{item.company_url ? <a href={item.company_url}>{item.company}</a> : item.company}
						</p>
					</div>
					<ul class="space-y-2 text-muted md:col-span-5">
						{item.points.map((point) => <li>{point}</li>)}
					</ul>
				</li>
			))}
		</ol>
	</Section>

	<Section id="education" heading={education.heading}>
		<ol class="divide-y divide-border">
			{education.items.map((item) => (
				<li class={row}>
					<p class="font-mono text-sm text-muted md:col-span-3">
						<time datetime={item.start}>{formatDate(item.start)}</time> –{' '}
						{item.end === 'present' ? item.end : <time datetime={item.end}>{formatDate(item.end)}</time>}
					</p>
					<div class="md:col-span-4">
						<h3 class="text-xl tracking-tight">{item.degree}</h3>
						<p class="mt-1 text-sm text-muted">{item.school}</p>
					</div>
					{item.note && <p class="text-muted md:col-span-5">{item.note}</p>}
				</li>
			))}
		</ol>
	</Section>

	<Section id="skills" heading={skills.heading}>
		<dl class="divide-y divide-border">
			{skills.groups.map((group) => (
				<div class="grid gap-x-8 gap-y-2 py-5 md:grid-cols-12">
					<dt class="meta md:col-span-3">{group.name}</dt>
					<dd class="font-mono text-sm md:col-span-9">{group.items.join(' / ')}</dd>
				</div>
			))}
		</dl>
	</Section>

	<Section id="contact" heading={contact.heading}>
		{contact.message && <p class="mt-8 max-w-2xl text-xl leading-relaxed md:text-2xl">{contact.message}</p>}
		<dl class="divide-y divide-border">
			{contactRows.map((item) => (
				<div class="grid gap-x-8 gap-y-2 py-5 md:grid-cols-12">
					<dt class="meta md:col-span-3">{item.label}</dt>
					<dd class="md:col-span-9">{item.href ? <a href={item.href}>{item.text}</a> : item.text}</dd>
				</div>
			))}
		</dl>
	</Section>
</BaseLayout>

<script>
	// Thumbnails (preload="none") load and play on desktop hover and reset on leave.
	// Under prefers-reduced-motion they stay posters.
	const still = window.matchMedia('(prefers-reduced-motion: reduce)');
	const desktop = window.matchMedia('(hover: hover) and (min-width: 64rem)');

	for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-thumb]')) {
		const row = video.closest('a')!;
		row.addEventListener('mouseenter', () => {
			if (desktop.matches && !still.matches) video.play().catch(() => {});
		});
		row.addEventListener('mouseleave', () => {
			video.pause();
			video.currentTime = 0;
		});
	}
</script>
